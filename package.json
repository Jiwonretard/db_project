{
  "name": "codegarden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:demo": "DB_CLIENT=sqlite npm run dev",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "db:init": "node server/init.js",
    "db:seed": "node server/seed.js",
    "test": "node --test tests/*.test.js",
    "db:setup": "node server/setup-mysql.js",
    "db:check": "node server/check-db.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.15.0",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
