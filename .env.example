# MySQL 8+ 연결 정보 (이 파일을 .env로 복사)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codegarden
# SQLite로 사용하려면 DB_CLIENT=sqlite
SQLITE_PATH=./data/codegarden.sqlite
PORT=3001
APP_ORIGIN=http://localhost:5173
OPENAI_API_KEY=
# 계정에서 사용 가능한 Responses API 모델로 변경 가능
OPENAI_MODEL=gpt-4.1-mini
